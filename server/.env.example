PORT=3001
# Dipakai untuk menandatangani token sesi pemain. Kosong = acak tiap server start.
SESSION_SECRET=
# Opsional (ms), default ada di src/config.ts
# BOT_DELAY_MS=700
# TRICK_RESOLVE_MS=1800
# TURN_LIMIT_MS=25000
# Isi 1 jika server di belakang proxy (Render, Fly, nginx); wajib agar batas koneksi per IP benar
# TRUST_PROXY=1
# Folder log match (JSONL) untuk replay: npm run verify-log -- <file>. Kosong = tidak menulis log.
# MATCH_LOG_DIR=./logs
# Postgres (Neon/Supabase gratis). Kosong = mode tamu, state hanya di memori.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Isi 1 agar semua pemain wajib punya akun (butuh DATABASE_URL)
# REQUIRE_LOGIN=1
# Jeda kartu trump tertutup sebelum dibuka bersamaan (ms)
# REVEAL_DELAY_MS=1200
